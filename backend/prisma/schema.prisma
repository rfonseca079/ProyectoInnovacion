generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Teacher {
  id                   String    @id @default(uuid())
  fullName             String
  email                String    @unique
  passwordHash         String
  schoolName           String
  regionalDirectorate  String
  sessions             Session[]
  plans                Plan[]
}

enum Cycle {
  I_II
  III
  DIVERSIFIED
}

enum Subject {
  MATH
  SPANISH
  SCIENCE
  SOCIAL_STUDIES
}

enum Modality {
  IN_PERSON
  VIRTUAL
  HYBRID
}

enum PlanStatus {
  DRAFT
  READY_FOR_DELIVERY
  ADJUSTED
}

enum BlockStatus {
  SUGGESTED
  ACCEPTED
  EDITED
}

enum DayKind {
  TEACHING
  HOLIDAY
  SUSPENDED
  ASSESSMENT
}

enum EvidenceKind {
  FORMATIVE
  SCHEDULED
}

model Plan {
  id                   String     @id @default(uuid())
  teacherId            String
  teacher              Teacher    @relation(fields: [teacherId], references: [id])
  cycle                Cycle
  gradeLevel           Int
  subject              Subject
  modality             Modality
  schoolYear           Int
  month                Int
  schoolName           String
  regionalDirectorate  String
  teacherName          String
  section              String
  studentCount         Int
  weeklyLessons        Int
  status               PlanStatus
  adjustmentApplied    Boolean    @default(false)
  currentStep          Int
  highestVisitedStep   Int
  scenarioId           String?
  scenario             Scenario?  @relation(fields: [scenarioId], references: [id])
  usedFallback         Boolean    @default(false)
  notifyEvaluationChanges Boolean @default(false)
  updatedAt            DateTime   @default(now())
  blocks               PlanBlock[]
  rubricItems          RubricItem[]
  weeks                Week[]
  evidence             Evidence[]
  classSessions        ClassSession[]
  mepDocument          MepDocument?
}

model Week {
  id       String  @id @default(uuid())
  planId   String
  plan     Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  position Int
  title    String
  active   Boolean @default(false)

  @@unique([planId, position])
}

model ClassSession {
  id                String      @id @default(uuid())
  planId            String
  plan              Plan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  weekPosition      Int
  position          Int
  day               String
  occursOn          DateTime    @db.Date
  expectedLearning  String
  durationMinutes   Int         @default(40)
  start             String
  development       String
  close             String
  materials         String
  formativeEvidence String
  homework          String?
  expanded          Boolean     @default(false)
  status            BlockStatus @default(SUGGESTED)
  planBNote         String?
  planBMinutes      Int?

  @@unique([planId, weekPosition, position])
}

model RubricItem {
  id         String @id @default(uuid())
  planId     String
  plan       Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  position   Int    @default(0)
  name       String
  count      Int    @default(1)
  percentage Int
}

model Scenario {
  id          String              @id
  schoolYear  Int
  subject     Subject
  gradeLevel  Int
  month       Int
  variants    SuggestionVariant[]
  plans       Plan[]
  calendarDays CalendarDay[]

  @@unique([schoolYear, subject, gradeLevel, month])
}

model CalendarDay {
  id         String   @id @default(uuid())
  scenarioId String
  scenario   Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date
  kind       DayKind
  label      String

  @@unique([scenarioId, date])
}

model SuggestionVariant {
  id         String   @id @default(uuid())
  scenarioId String
  scenario   Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  blockKey   String
  step       Int
  variant    Int
  body       String

  @@unique([scenarioId, blockKey, variant])
}

model PlanBlock {
  id       String      @id @default(uuid())
  planId   String
  plan     Plan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  blockKey String
  status   BlockStatus @default(SUGGESTED)
  variant  Int
  body     String

  @@unique([planId, blockKey])
}

model Evidence {
  id               String       @id @default(uuid())
  planId           String
  plan             Plan         @relation(fields: [planId], references: [id], onDelete: Cascade)
  kind             EvidenceKind
  position         Int
  blockKey         String
  title            String
  measures         String
  when             String
  instrument       String
  expectedLearning String
  occursOn         DateTime?    @db.Date

  @@unique([planId, blockKey])
  @@unique([planId, kind, position])
}

model MepDocument {
  id                  String   @id @default(uuid())
  planId              String   @unique
  plan                Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  regionalDirectorate String
  schoolName          String
  teacherName         String
  subjectLabel        String
  gradeLabel          String
  schoolYear          Int
  periodicity         String
  competencies        String
  observations        String
  instruments         String[]
  rows                MepRow[]
}

model MepRow {
  id                String      @id @default(uuid())
  documentId        String
  document          MepDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  position          Int
  expectedLearning  String
  mediationStrategy String
  indicator         String

  @@unique([documentId, position])
}

model Session {
  id        String   @id @default(uuid())
  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}
